<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainController">

    <children>

        <Label layoutX="30"
               layoutY="20"
               text="EcoWallet"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <TextField fx:id="descricaoField"
                   layoutX="30"
                   layoutY="80"
                   prefWidth="200"
                   promptText="Descrição" />

        <TextField fx:id="valorField"
                   layoutX="250"
                   layoutY="80"
                   prefWidth="120"
                   promptText="Valor" />

        <Button layoutX="390"
                layoutY="80"
                text="Adicionar"
                onAction="#adicionarTransacao"/>

        <TableView fx:id="tabelaTransacoes"
                   layoutX="30"
                   layoutY="140"
                   prefHeight="350"
                   prefWidth="700">

            <columns>

                <TableColumn fx:id="colDescricao"
                             prefWidth="250"
                             text="Descrição" />

                <TableColumn fx:id="colValor"
                             prefWidth="150"
                             text="Valor" />

                <TableColumn fx:id="colData"
                             prefWidth="150"
                             text="Data" />

                <TableColumn fx:id="colCategoria"
                             prefWidth="150"
                             text="Categoria" />

            </columns>

        </TableView>

        <Label fx:id="saldoLabel"
               layoutX="30"
               layoutY="520"
               text="Saldo Total: R$ 0.00"
               style="-fx-font-size: 18px;" />

    </children>

</AnchorPane>